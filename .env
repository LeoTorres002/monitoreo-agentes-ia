# Config local de SIAF. NO versionar, NO exponer.

# --- Bonsai (llama-server) ---
# Endpoint OpenAI-compatible de llama-server. POR DEFECTO modes usar para el
# destripador (agente_referencia, trabajo por lotes). En CPU (27B F16 ~0.75 tok/s)
# NO sirve para QA interactivo: el modelo razona verbosamente antes de responder.
BONSAI_URL=http://host.containers.internal:11435/v1
BONSAI_API_KEY=hErP7zOKpbvPqh9LDAbfYkSC6ithe-5IeTW89NoUMo8
# Comando para levantar el servidor (ya corriendo con estos flags):
#   ~/.local/bin/llama serve -hf prism-ml/Bonsai-27B-gguf:F16 \
#     --host 0.0.0.0 --port 11435 --api-key "$BONSAI_API_KEY" --ctx-size 8192 --reasoning-format none

# --- Ollama ---
# Queda SOLO para embeddings de RAG (nomic-embed-text) y, por defecto, para el
# LLM del QA (RAG_LLM_*), porque es lo unico interactivo en esta PC.
OLLAMA_URL=http://host.containers.internal:11434

# --- LLM del QA (agente_environmental) ---
# Apuntar aqui a un LLM rapido. Si quieres Bonsai aqui, iguala a BONSAI_URL y
# aguanta el rendimiento (minutos/consulta con max_tokens alto).
RAG_LLM_URL=http://host.containers.internal:11434/v1
RAG_LLM_MODEL=llama3